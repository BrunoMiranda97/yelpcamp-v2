# MongoDB connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/yelpcamp

# At least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated origins allowed to call the API cross-origin (optional; same-origin needs nothing)
ALLOWED_ORIGINS=

# Mapbox public token (used by the frontend map and backend geocoding)
VITE_MAPBOX_TOKEN=

# Cloudinary credentials for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Local API port (Vite proxies /api to it)
PORT=3001
