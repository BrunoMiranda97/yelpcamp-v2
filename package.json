  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch api/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node build/api/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:api": "tsc -p tsconfig.api.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
